{
  "name": "@canvas-display/server",
  "version": "0.1.0",
  "description": "Canvas Display Server — central config and device management",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "build:sidecar": "tsc && rm -rf ../browser/linux/src-tauri/binaries/public && cp -r public ../browser/linux/src-tauri/binaries/public && npx pkg dist/index.js --target node20-linux-x64 --compress GZip --output ../browser/linux/src-tauri/binaries/canvas-display-server-x86_64-unknown-linux-gnu"
  },
  "pkg": {
    "targets": ["node20-linux-x64"],
    "outputPath": ".",
    "assets": [],
    "scripts": ["dist/**/*.js"],
    "input": "dist/index.js",
    "output": "canvas-display-server"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^7.0.4",
    "better-sqlite3": "^9.6.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "mqtt": "^5.15.1",
    "nanoid": "^5.0.7",
    "ws": "^8.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/mqtt": "^0.0.34",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "@yao-pkg/pkg": "^6.14.2",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  }
}
