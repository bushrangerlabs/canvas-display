{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "Canvas Display",
  "version": "0.2.21",
  "identifier": "com.bushrangerlabs.canvas-display-browser",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Canvas Display",
        "width": 1920,
        "height": 1080,
        "fullscreen": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "externalBin": [
      "binaries/canvas-display-server"
    ],
    "resources": {
      "binaries/better_sqlite3.node": "binaries/better_sqlite3.node",
      "binaries/public": "binaries/public"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "libc6",
          "libwebkit2gtk-4.1-0",
          "alsa-utils",
          "pulseaudio-utils",
          "mpv"
        ]
      }
    }
  }
}
