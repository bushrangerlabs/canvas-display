{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "scripts/**/*contracts*.ts",
    "packages/protocol-ts/src/**/*.ts",
    "edge/simulator/**/*.ts",
    "edge/content-bridge-prototype/**/*.ts",
    "tests/**/*.ts"
  ]
}
