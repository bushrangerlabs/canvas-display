# Canvas Core environment (copy to .env; never commit real secrets).
CANVAS_CORE_PORT=3100

# External PostgreSQL (the `postgresql` Docker container on the host)
CANVAS_CORE_DB_USER=casaos
CANVAS_CORE_DB_PASSWORD=casaos
CANVAS_CORE_DB_NAME=canvas_core

# AI brain external services (D-009/D-010). Point these at your running containers.
# The main server already runs: llama.cpp (qwen36-mtp), speaches/whisper, piper-tts, afl-mcp.
CANVAS_CORE_LLM_BASE_URL=http://host.docker.internal:8089/v1
CANVAS_CORE_WHISPER_URL=http://host.docker.internal:10301
CANVAS_CORE_WHISPER_MODEL=Systran/faster-whisper-base.en
# Random scoped secret shared only with the physical Edge voice bridge.
CANVAS_CORE_EDGE_VOICE_TOKEN=
# Random bearer token used by trusted automation clients such as Home Assistant.
# Generate with: openssl rand -hex 32
CANVAS_CORE_AUTOMATION_TOKEN=
CANVAS_CORE_PIPER_URL=http://host.docker.internal:10200
# MCP servers (D-011: Core connects to multiple MCP servers)
# Option 1: comma-separated list (HTTP servers)
CANVAS_CORE_MCP_URLS=http://host.docker.internal:5020
# Option 2: individual HTTP servers with names
# CANVAS_CORE_MCP_URL_1=http://host.docker.internal:5020
# CANVAS_CORE_MCP_NAME_1=afl-mcp
# CANVAS_CORE_MCP_URL_2=http://host.docker.internal:5021
# CANVAS_CORE_MCP_NAME_2=home-assistant-mcp
# Option 3: single server (backward compat)
# CANVAS_CORE_MCP_URL=http://host.docker.internal:5020
# Option 4: stdio (child-process) MCP servers — no HTTP port needed
# CANVAS_CORE_MCP_CMD_1=python3
# CANVAS_CORE_MCP_ARGS_1=/app/au_weather_stdio.py
# CANVAS_CORE_MCP_NAME_1=au-weather
# CANVAS_CORE_MCP_CMD_2=python3
# CANVAS_CORE_MCP_ARGS_2=/app/bowling_mcp.py
# CANVAS_CORE_MCP_NAME_2=bowling
# Args are comma-separated; env vars for the child process:
# CANVAS_CORE_MCP_ENV_1=KEY=value,KEY2=value2

# Home Assistant integration (D-012). Use a long-lived access token.
CANVAS_CORE_HA_URL=http://192.168.1.103:8123
CANVAS_CORE_TIMEZONE=Australia/Melbourne
CANVAS_CORE_HA_TOKEN=

CANVAS_CORE_LOG_LEVEL=info

# Device enrollment issuer key. Generate once with `openssl rand -hex 32`, keep it secret, and
# preserve it across every Core restart/redeploy; rotating it invalidates issued credentials.
CANVAS_CORE_ENROLLMENT_SEED=
CANVAS_CORE_SECURITY_EPOCH=1

# Bootstrap only. Set false after every intended device has an enrolled credential.
CANVAS_CORE_ALLOW_OPEN_PAIRING=true

# ─── Multi-provider AI registry (D-010 extension) ───────────────────────────
# Advanced mode: configure multiple LLM/ASR/TTS providers and route tasks to them.
# When set, this takes precedence over the legacy single-provider vars above.
#
# CANVAS_CORE_AI_PROVIDERS is a JSON object:
#   {
#     "providers": [
#       {"id": "local-llm", "type": "llm", "kind": "llama-cpp", "config": {"baseUrl": "http://host.docker.internal:8089/v1", "model": "qwen3.6"}},
#       {"id": "cloud-llm", "type": "llm", "kind": "openrouter", "config": {"apiKey": "sk-or-...", "model": "anthropic/claude-3.5-sonnet"}},
#       {"id": "local-asr", "type": "asr", "kind": "whisper", "config": {"baseUrl": "http://host.docker.internal:10301", "model": "Systran/faster-whisper-base.en"}},
#       {"id": "local-tts", "type": "tts", "kind": "piper", "config": {"host": "host.docker.internal", "port": 10200}}
#     ],
#     "assignments": {
#       "intent_routing": "local-llm",
#       "conversation": "cloud-llm",
#       "asr": "local-asr",
#       "tts": "local-tts"
#     }
#   }
#
# Provider kinds:
#   LLM: openai, openrouter, anthropic, gemini, groq, azure, llama-cpp, ollama, vllm
#   ASR: whisper
#   TTS: piper
#
# Task types: intent_routing, conversation, asr, tts, embedding
# (If no assignment is given for a task, the first provider of the matching type is used.)
#
# CANVAS_CORE_AI_PROVIDERS=
#
# Optional: separate JSON for task assignments (merged with the JSON config above).
# CANVAS_CORE_AI_TASK_ASSIGNMENTS={"intent_routing":"local-llm","conversation":"cloud-llm"}
#
# Simple-mode overrides (used when CANVAS_CORE_AI_PROVIDERS is unset):
# CANVAS_CORE_LLM_API_KEY=
# CANVAS_CORE_LLM_MODEL=
# CANVAS_CORE_PIPER_HOST=
# CANVAS_CORE_PIPER_PORT=
