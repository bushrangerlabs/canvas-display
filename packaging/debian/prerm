#!/bin/sh
# prerm — canvas-edge package pre-removal script
set -e

case "$1" in
  remove|upgrade|deconfigure)
    # Stop services before removal (ignore failures if already stopped)
    if command -v systemctl >/dev/null 2>&1; then
      systemctl stop canvas-edge-agent.service || true
      systemctl stop canvas-edge-updater.service || true
    fi
    ;;

  failed-upgrade)
    exit 0
    ;;

  *)
    echo "prerm called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

exit 0
