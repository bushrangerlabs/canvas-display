#!/bin/sh
# postinst — canvas-edge package post-installation script
set -e

case "$1" in
  configure)
    # Create dedicated service users (idempotent — systemd-sysusers or adduser)
    if command -v systemd-sysusers >/dev/null 2>&1; then
      # systemd 247+ can create users via sysusers.d; we provide a snippet
      :  # handled by sysusers fragment shipped in the package
    fi

    # Ensure service users exist (fallback for systems without sysusers.d)
    if ! getent passwd canvas-edge-agent >/dev/null 2>&1; then
      adduser --system --no-create-home --group \
        --shell /usr/sbin/nologin \
        --gecos "Canvas Edge Agent" canvas-edge-agent
    fi
    if ! getent passwd canvas-edge-updater >/dev/null 2>&1; then
      adduser --system --no-create-home --group \
        --shell /usr/sbin/nologin \
        --gecos "Canvas Edge Updater" canvas-edge-updater
    fi

    # Create /usr/bin symlinks for PATH compatibility
    # (binaries live in /usr/lib/canvas-edge/ per Debian policy)
    if [ ! -L /usr/bin/canvas-edge-agentd ]; then
      ln -s /usr/lib/canvas-edge/canvas-edge-agentd /usr/bin/canvas-edge-agentd
    fi
    if [ ! -L /usr/bin/canvas-edge-updaterd ]; then
      ln -s /usr/lib/canvas-edge/canvas-edge-updaterd /usr/bin/canvas-edge-updaterd
    fi

    # Reload systemd and enable+start services
    if command -v systemctl >/dev/null 2>&1; then
      systemctl daemon-reload
      systemctl enable canvas-edge-updater.service || true
      systemctl enable canvas-edge-agent.service || true
      systemctl start canvas-edge-updater.service || true
      systemctl start canvas-edge-agent.service || true
    fi
    ;;

  abort-upgrade|abort-remove|abort-deconfigure)
    exit 0
    ;;

  *)
    echo "postinst called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

exit 0
