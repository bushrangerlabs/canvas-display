usr/lib/canvas-edge/canvas-edge-updaterd usr/lib/canvas-edge/

# systemd service units
packaging/systemd/canvas-edge-agent.service etc/systemd/system/
packaging/systemd/canvas-edge-updater.service etc/systemd/system/
